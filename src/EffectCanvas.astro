---
/**
 * EffectCanvas — GPU shader background for heroes, headers + sections.
 *
 *   <div class="relative">
 *     <EffectCanvas name="aurora" />
 *     <div class="relative z-10">…content…</div>
 *   </div>
 *
 * Renders a full-bleed, absolutely-positioned <canvas> that draws one
 * of nine built-in fragment shaders (see `EffectName` in ./types):
 *
 *   aurora | mesh | waves | grid | particles | grain | liquid |
 *   mesh-gradient | grain-gradient
 *
 * Props (all optional except `name` — see EffectConfig for full docs):
 *
 *   name         which shader to render
 *   colors       up to 4 hex colours; defaults derive from the LIVE
 *                `--color-accent` token, so presets re-tint effects
 *                automatically. Only the two *-gradient shaders read
 *                the 4th.
 *   speed        animation speed multiplier (0–4, default 1)
 *   intensity    brightness/contrast multiplier (0–2, default 1)
 *   opacity      uniform CSS opacity on the canvas (0–1, default 1)
 *   static       render ONE frame, no loop — for wallpaper (default false)
 *   frame        which moment to freeze at when static (default 12)
 *   interactive  smoothed mouse-tracking uniform (default false)
 *   blend        CSS mix-blend-mode (default 'normal')
 *   fade         edge mask: 'bottom' (default) | 'top' | 'both' | 'none'
 *   class        extra classes for the canvas element
 *
 * Usage from MDX / sections:
 *
 *   import EffectCanvas from '@/components/effects/EffectCanvas.astro';
 *   <EffectCanvas name="mesh" speed={0.7} intensity={0.8} interactive />
 *
 * Wired into the homepage hero via `siteConfig.hero.effect` — see
 * HomeHero.astro and the HeroConfig type.
 *
 * Guarantees:
 *   - `prefers-reduced-motion: reduce` → one static frame, no loop.
 *   - Pauses when offscreen (IntersectionObserver) or tab hidden.
 *   - Device-pixel-ratio capped at 1.75 — decorative layers don't
 *     get to quadruple the fragment bill on retina screens.
 *   - No WebGL → graceful CSS radial-gradient fallback, same colours.
 *   - `pointer-events: none` always; `aria-hidden` always.
 *   - Survives View Transitions (re-binds on `astro:after-swap`,
 *     loops self-terminate when their canvas leaves the DOM).
 */
import type { EffectConfig } from './types';

interface Props extends EffectConfig {
	/** Extra class names merged onto the canvas element. */
	class?: string;
}

const {
	name,
	colors,
	speed = 1,
	intensity = 1,
	opacity = 1,
	static: isStatic = false,
	frame = 12,
	interactive = false,
	blend = 'normal',
	fade = 'bottom',
	class: className,
} = Astro.props;
---
<canvas
	class:list={['effect-canvas', fade !== 'none' && `effect-canvas--fade-${fade}`, className]}
	data-effect={name}
	data-effect-speed={speed}
	data-effect-intensity={intensity}
	data-effect-colors={colors && colors.length > 0 ? colors.join(',') : undefined}
	data-effect-static={isStatic ? 'on' : undefined}
	data-effect-frame={isStatic ? frame : undefined}
	data-effect-interactive={interactive && !isStatic ? 'on' : undefined}
	style={`opacity: ${opacity};${blend !== 'normal' ? ` mix-blend-mode: ${blend};` : ''}`}
	aria-hidden="true"
></canvas>

<script>
	/**
	 * EffectCanvas runtime — one shared module for every effect canvas
	 * on the page (Astro de-dupes processed scripts, so this executes
	 * once no matter how many instances render).
	 *
	 * Architecture:
	 *   - SHADERS holds the six fragment-shader bodies; HELPERS holds
	 *     shared GLSL (hash / value noise / fbm) prepended to each.
	 *   - mount() compiles the program for one canvas, sizes it (DPR
	 *     capped), and starts a rAF loop gated on three switches:
	 *     viewport visibility, tab visibility, reduced-motion.
	 *   - Loops self-terminate when their canvas is removed from the
	 *     DOM (View Transition swaps), and init() re-binds new ones
	 *     via `astro:after-swap`.
	 */
	(function () {
		const BOUND = Symbol.for('apEffectCanvasBound');
		if ((globalThis as any)[BOUND]) return;
		(globalThis as any)[BOUND] = true;

		const prefersReduced =
			typeof window !== 'undefined' &&
			window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

		/** Max device-pixel-ratio a decorative layer is allowed to render at. */
		const DPR_CAP = 1.75;

		/* ---------------------------------------------------------- *
		 * GLSL
		 * ---------------------------------------------------------- */

		/** Fullscreen-triangle vertex shader shared by every effect. */
		const VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';

		/**
		 * Shared fragment header: uniforms + hash / value-noise / fbm
		 * helpers. Prepended to every shader body in SHADERS.
		 *
		 * Uniform contract:
		 *   u_res        canvas size in physical px
		 *   u_time       seconds elapsed × the instance's speed prop
		 *   u_c1..u_c4   the four effect colours (linear-ish RGB 0–1).
		 *                Only the gradient shaders read u_c4; the rest
		 *                use the first three.
		 *   u_intensity  brightness multiplier from the intensity prop
		 *   u_mouse      smoothed cursor in 0–1 UV space (0.5,0.5 idle)
		 */
		const HELPERS = `
precision highp float;
uniform vec2 u_res;
uniform float u_time;
uniform vec3 u_c1;
uniform vec3 u_c2;
uniform vec3 u_c3;
uniform vec3 u_c4;
uniform float u_intensity;
uniform vec2 u_mouse;
float hash(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
float vnoise(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);
	float a=hash(i),b=hash(i+vec2(1.,0.)),c=hash(i+vec2(0.,1.)),d=hash(i+vec2(1.,1.));
	return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*vnoise(p);p*=2.03;a*=.5;}return v;}
/* Rotate p around the origin by \`a\` radians. */
vec2 rot(vec2 p,float a){float s=sin(a),c=cos(a);return mat2(c,-s,s,c)*p;}
/* Vortex: rotate harder near the centre, falling off to nothing by
   the edge, so the warp reads as a swirl rather than a spin. */
vec2 swirl(vec2 p,float amt){float r=length(p);return rot(p,amt*(1.-smoothstep(0.,.9,r)));}
`;

		/**
		 * The shader registry. Every body defines main(), reads the
		 * uniform contract above, and writes vec4(rgb, alpha) where
		 * alpha tracks brightness — the canvas is composited over the
		 * section background, so dark pixels stay transparent.
		 */
		const SHADERS: Record<string, string> = {
			/* Slow curtains of accent light drifting over fbm noise. */
			aurora: `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	vec2 p=vec2(uv.x*u_res.x/u_res.y,uv.y);
	p+=(u_mouse-.5)*.12;
	float t=u_time*.05;
	float n1=fbm(p*vec2(1.1,2.1)+vec2(t,-t*.55));
	float n2=fbm(p*vec2(1.7,2.8)-vec2(t*.7,t*.35)+7.31);
	float curtain=smoothstep(.32,.95,n1)*(.35+.65*n2);
	float falloff=smoothstep(.0,.55,uv.y)*.9+.1;
	vec3 col=(u_c1*n1+u_c3*n2*.6)*curtain*falloff;
	col+=u_c2*.22*smoothstep(.45,1.,n2)*falloff;
	col*=u_intensity;
	float a=clamp(max(max(col.r,col.g),col.b)*1.5,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Four orbiting radial blobs — the animated mesh-gradient. */
			mesh: `
float blob(vec2 p,vec2 c,float r){float d=length(p-c);return r*r/(d*d+r*r);}
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	vec2 p=(uv-.5)*vec2(ar,1.);
	float t=u_time*.22;
	vec2 m=(u_mouse-.5)*vec2(ar,1.);
	vec3 col=vec3(0.);
	col+=u_c1*.50*blob(p,vec2(sin(t*.70)*.55,cos(t*.50)*.34),.30);
	col+=u_c2*.45*blob(p,vec2(cos(t*.40+2.)*.60,sin(t*.60+1.)*.40),.36);
	col+=u_c3*.40*blob(p,vec2(sin(t*.50+4.)*.50,cos(t*.34+3.)*.44),.28);
	col+=u_c1*.20*blob(p,m,.22);
	col*=u_intensity;
	float a=clamp(max(max(col.r,col.g),col.b)*1.3,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Three glowing waveform lines — audio-signal look. */
			waves: `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	float t=u_time;
	vec3 col=vec3(0.);
	for(int i=0;i<3;i++){
		float fi=float(i);
		float yy=.5+(fi-1.)*.15+(u_mouse.y-.5)*.05;
		float w=sin(uv.x*(4.5+fi*1.4)*ar*.6+t*(.45+fi*.2)+fi*2.1)
		       *sin(uv.x*1.6*ar-t*.3+fi*.7);
		float amp=.09+.045*fi;
		float d=abs(uv.y-yy-w*amp);
		vec3 c=i==0?u_c1:(i==1?u_c2:u_c3);
		col+=c*(.005/(d+.004))*.55;
	}
	col*=u_intensity;
	float a=clamp(max(max(col.r,col.g),col.b)*1.2,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Perspective floor grid scrolling to the horizon + glow line. */
			grid: `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	float horizon=.62;
	vec3 col=vec3(0.);
	if(uv.y<horizon){
		float z=(horizon-uv.y)+.015;
		float pz=1./z;
		vec2 g=vec2((uv.x-.5)*ar*pz*.9,pz*.5+u_time*1.1);
		float dx=abs(fract(g.x+.5)-.5);
		float dy=abs(fract(g.y+.5)-.5);
		float fog=smoothstep(.0,.45,z);
		float line=(.022/(dx+.018)+.022/(dy+.018))*.5;
		col+=u_c1*line*fog*.85;
	}
	col+=u_c2*exp(-abs(uv.y-horizon)*22.)*.55;
	col+=u_c3*exp(-abs(uv.y-horizon)*5.)*.10;
	col*=u_intensity;
	float a=clamp(max(max(col.r,col.g),col.b)*1.35,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Three parallax layers of drifting, twinkling specks. */
			particles: `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	vec2 p=vec2(uv.x*ar,uv.y);
	vec3 col=vec3(0.);
	for(int i=0;i<3;i++){
		float fi=float(i);
		float scale=14.+fi*12.;
		vec2 drift=vec2(u_time*(.018+fi*.012),u_time*.008*(fi-1.));
		drift+=(u_mouse-.5)*.04*(fi+1.);
		vec2 g=p*scale+drift*scale;
		vec2 id=floor(g);
		vec2 f=fract(g);
		vec2 pos=vec2(hash(id),hash(id+7.7))*.7+.15;
		float d=length(f-pos);
		float tw=.5+.5*sin(u_time*(.8+hash(id)*2.4)+hash(id)*6.28);
		vec3 c=i==0?u_c1:(i==1?u_c2:u_c3);
		col+=c*(.03/(d+.035))*tw*(.55-fi*.13);
	}
	col*=u_intensity;
	float a=clamp(max(max(col.r,col.g),col.b)*1.6,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Liquid surface — flowing accent "water" where pointer movement
			 * spawns damped, expanding ripple rings. Renders OPAQUE (it's a
			 * surface fill, not a glow overlay): built for CTAs/buttons via
			 * `.cta--fx`, also works as a full section backdrop.
			 * Ripple state arrives in u_rip[8]: xy = uv origin, z = birth
			 * time in shader seconds, w = strength (0 = empty slot). */
			liquid: `
uniform vec4 u_rip[8];
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	vec2 p=vec2(uv.x*ar,uv.y);
	float t=u_time;
	float h=(fbm(p*2.6+vec2(t*.10,-t*.07))-.5)*.5;
	h+=(fbm(p*5.2-vec2(t*.06,t*.04))-.5)*.22;
	for(int i=0;i<8;i++){
		vec4 r=u_rip[i];
		float age=t-r.z;
		if(r.w<=0.||age<0.)continue;
		vec2 rp=vec2(r.x*ar,r.y);
		float d=length(p-rp);
		h+=sin(d*42.-age*7.5)*exp(-d*6.5)*exp(-age*2.4)*r.w*.6;
	}
	vec3 base=mix(u_c2,u_c1,clamp(.62+h*1.1,0.,1.));
	float spec=smoothstep(.16,.44,h);
	vec3 col=base+u_c3*spec*.25+vec3(spec*.22);
	col*=u_intensity;
	gl_FragColor=vec4(col,1.);
}`,

			/* Animated film grain + faint accent vignette. The quiet one. */
			grain: `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float g=hash(uv*u_res*.5+fract(u_time*.7)*vec2(17.,31.));
	float vig=1.-smoothstep(.1,.8,distance(uv,vec2(.5,.45)));
	vec3 col=u_c1*vig*.10+u_c2*(1.-vig)*.03;
	col+=vec3(g)*.06;
	col*=u_intensity;
	float a=clamp((g*.5+vig*.55)*.5*u_intensity,0.,1.);
	gl_FragColor=vec4(col,a);
}`,

			/* Modern gradient-mesh wash: four colour spots drifting on
			 * distinct trajectories, domain-warped by fbm and pulled
			 * through a slow vortex, blended by INVERSE-DISTANCE weight so
			 * there are no visible spot edges (unlike `mesh`, whose
			 * metaballs read as discrete blobs). Finished with fine grain,
			 * which is what stops big smooth gradients from banding on
			 * 8-bit displays.
			 *
			 * Alpha tracks brightness — this composites OVER the page
			 * rather than replacing it, which is what keeps text contrast
			 * intact when it's used as a full-page surface. */
			/* A glossy sheet rippling away to a horizon — the "waterPlane"
			   look, done as a raked ground plane in a fragment shader
			   rather than a displaced 3D mesh. The perspective divide is
			   what sells it: sampling density rises with distance, so the
			   ripples compress toward the horizon the way real perspective
			   does. A finite-difference normal off the same height field
			   gives the specular sheen without a light rig.

			   Masks ALPHA rather than multiplying the colour down (the
			   lesson from mesh-gradient), so it composites cleanly on a
			   light page instead of turning grey. */
			/* The flat "plane" of the set — a silk sheet facing the camera,
			   displaced by two noise octaves and lit. No perspective
			   divide (that's water-plane's job); the read here is broad
			   diagonal colour flow with a soft specular roll across it. */
			'gradient-plane': `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	vec2 p=(uv-.5)*vec2(ar,1.);
	float t=u_time*.16;

	/* Slight rake so the flow runs diagonally rather than square to
	   the viewport — square bands read as a CSS gradient, not a mesh. */
	vec2 q=rot(p,.42)*1.25;
	q+=(u_mouse-.5)*vec2(ar,1.)*.12;

	float h=fbm(q+vec2(t*.7,-t*.5))+.5*fbm(q*2.3+vec2(-t*.4,t*.8));

	float e=.03;
	float hx=fbm(q+vec2(e,0.)+vec2(t*.7,-t*.5))+.5*fbm((q+vec2(e,0.))*2.3+vec2(-t*.4,t*.8));
	float hy=fbm(q+vec2(0.,e)+vec2(t*.7,-t*.5))+.5*fbm((q+vec2(0.,e))*2.3+vec2(-t*.4,t*.8));
	vec3 n=normalize(vec3((h-hx)*2.6,(h-hy)*2.6,1.));

	float ramp=clamp(h*.9+.1,0.,1.);
	vec3 col=mix(u_c1,u_c2,smoothstep(.18,.82,ramp));
	float spec=pow(max(dot(n,normalize(vec3(-.3,.5,.8))),0.),14.);
	col=mix(col,u_c3,spec*.5);

	/* Alpha-masked (never colour-multiplied) so it survives a light page. */
	float vig=1.-smoothstep(.30,1.05,length(p));
	float a=vig*(.30+.50*ramp+spec*.45)*u_intensity;

	gl_FragColor=vec4(col*u_intensity,clamp(a,0.,1.));
}
`,

			/* The "sphere" of the set — an implicit orb rather than a
			   displaced mesh: z is solved from the circle equation, the
			   normal comes from that, and noise perturbs it. Cheaper than
			   ray-marching and indistinguishable at this softness. The rim
			   term is what stops it reading as a flat pasted circle. */
			'gradient-sphere': `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float ar=u_res.x/u_res.y;
	vec2 p=(uv-.5)*vec2(ar,1.);
	float t=u_time*.15;

	vec2 c=vec2(.06,-.02)+(u_mouse-.5)*vec2(ar,1.)*.06;
	float R=.66;
	vec2 rel=p-c;
	float r=length(rel);

	/* Surface normal from the implicit sphere. Outside the radius we
	   clamp to the silhouette so the rim glow still has a normal. */
	float z=sqrt(max(R*R-r*r,0.));
	vec3 n=normalize(vec3(rel,z+1e-4));

	/* Two octaves over the surface, advected so it churns in place, then
	   perturb the normal by their gradient so the light reacts to the
	   churn instead of sliding over a perfect sphere. */
	float nz=fbm(n.xy*2.4+vec2(t,-t*.8))+.5*fbm(n.xy*5.0+vec2(-t*.7,t*1.1));
	float e=.045;
	float nzx=fbm((n.xy+vec2(e,0.))*2.4+vec2(t,-t*.8))+.5*fbm((n.xy+vec2(e,0.))*5.0+vec2(-t*.7,t*1.1));
	float nzy=fbm((n.xy+vec2(0.,e))*2.4+vec2(t,-t*.8))+.5*fbm((n.xy+vec2(0.,e))*5.0+vec2(-t*.7,t*1.1));
	n=normalize(n+vec3((nz-nzx)*.55,(nz-nzy)*.55,0.));

	float ramp=clamp(nz*.85+.12+n.y*.25,0.,1.);
	vec3 col=mix(u_c1,u_c2,smoothstep(.16,.86,ramp));
	float spec=pow(max(dot(n,normalize(vec3(-.35,.6,.72))),0.),22.);
	col=mix(col,u_c3,spec*.6);

	/* Soft body + a rim that lifts the silhouette. */
	float body=1.-smoothstep(R*.72,R*1.04,r);
	float rim=smoothstep(R*.80,R*1.0,r)*(1.-smoothstep(R*1.0,R*1.22,r));
	float a=(body*(.34+.46*ramp+spec*.5)+rim*.30)*u_intensity;

	gl_FragColor=vec4(col*u_intensity,clamp(a,0.,1.));
}
`,
			/* Vertical light beams — the "curtain" hero background. The whole
			   trick is that the noise is sampled across X ONLY: with no y
			   term the value is constant down each column, which is what
			   makes a band read as a beam rather than a blob. Three
			   octaves at different widths and drift speeds keep it from
			   looking like a repeating stripe pattern, and a top-down
			   falloff sells "light coming from above".

			   Alpha-masked, so it composites over any page colour. */
			/* Band-lens refraction — a flowing two-colour gradient sampled
			   through a grid of lens cells that are ~100x wider than they
			   are tall. That aspect ratio is the whole effect: a cell
			   spanning the full width but 1/100th of the height smears the
			   gradient VERTICALLY, so a smooth colour field resolves into
			   tall irregular streaks with bright refracted edges.

			   Two properties fall out of the geometry rather than being
			   drawn in, which is why this reads as light rather than as
			   stripes: streak WIDTH varies with the local gradient slope
			   (so the bands are uneven), and the brightest pixels land at
			   cell edges where the lens warp is strongest.

			   Technique measured from a reference implementation; the
			   parameter defaults below are its shipped values. */
			'band-lens': `
/* One cell of the lens grid. Tiling with fract() puts every fragment in
   its own cell, then the sphere equation gives the warp for that cell. */
vec2 bandLens(vec2 p, float spacingX, float spacingY, float radiusSq){
	vec2 c;
	c.x = fract(p.x/spacingX + .5)*spacingX - spacingX*.5;
	c.y = fract(p.y/spacingY + .5)*spacingY - spacingY*.5;
	float sp = radiusSq - c.x*c.x - c.y*c.y;
	float amount = smoothstep(-.1, .05, sp);
	float lens = sqrt(max(sp, -sp*.1)/.3);
	float warp = mix(1., lens, amount);
	vec2 out_ = p;
	out_.x += c.x*warp - c.x;
	out_.y *= warp;          /* the vertical smear */
	return out_;
}

/* Smooth flowing scalar in 0-1, from three interfering directional waves.
   Cheaper and far smoother than fbm, which is what keeps the streaks clean
   instead of grainy. */
float flowField(vec2 uv, float t){
	vec2 d1 = vec2(cos(1.31), sin(1.31));
	vec2 d2 = vec2(cos(4.02), sin(4.02));
	/* Time terms are negated relative to the obvious reading: the field
	   drifts right-to-left. Flip the signs on the two t terms to reverse
	   it — that is the only thing controlling travel direction. */
	float a = dot(uv,d1) + sin(dot(uv,d2)*2.1 - t)*.30 - t*.20;
	float b = dot(uv,d2.yx) + cos(dot(uv,d1.yx)*1.9 + t*.80)*.25;
	float v = sin(a*1.5)*.5 + .5;
	v += cos(b*1.2)*1.3;
	v += sin(dot(uv,d1+d2)*2.4 - t*3.5)*1.2;
	return smoothstep(0., 4.12, v);
}

void main(){
	vec2 r = u_res;
	/* Aspect-correct, origin-centred — matches the reference's framing. */
	vec2 p = (gl_FragCoord.xy*2. - r)/r.y;
	float t = u_time*.30;

	/* Deliberately NOT rotated. The beams are plumb — the reference sets
	   no rotation uniform, and tilting them reads as a swipe rather than
	   as light falling. The irregularity comes from the flow field, not
	   from any angle. */
	float scale = 3.7;
	vec2 warped = bandLens(p*scale, 1.0, 0.01, 0.41*0.41);
	float g = flowField(warped/scale, t*.8);

	/* Two-stop ramp: accent into the page tone. A third colour would mud
	   the streaks — the reference ships two for the same reason. */
	vec3 col = mix(u_c2, u_c1, g);

	/* ALPHA carries the streaks, never a darkened colour (see the note on
	   mesh-gradient). Squared so dim areas fall to fully transparent and
	   the page black shows through between beams. */
	float a = g*g*u_intensity;

	gl_FragColor = vec4(col, clamp(a, 0., 1.));
}
`,
			'beams': `
void main(){
	vec2 uv=gl_FragCoord.xy/u_res;
	float t=u_time*.10;

	/* Sampled on X only — constant down each column. The second
	   coordinate is time, so beams breathe in place instead of sliding. */
	float b =      smoothstep(.42,1.,vnoise(vec2(uv.x* 5.0,       t*.45)));
	b += .70*      smoothstep(.50,1.,vnoise(vec2(uv.x*13.0+ 9.1,  t*.30)));
	b += .45*      smoothstep(.58,1.,vnoise(vec2(uv.x*27.0+ 3.7,  t*.65)));
	b += .28*      smoothstep(.62,1.,vnoise(vec2(uv.x*53.0+21.3,  t*.85)));
	b/=2.43;

	/* Light falls from the top. gl_FragCoord.y is bottom-up, so uv.y=1
	   is the top edge — raise it to bias the glow into the upper third. */
	float fall=pow(clamp(uv.y,0.,1.),1.9);

	/* A slow vertical wash breaks the columns up so they don't read as
	   hard bars all the way down. */
	float wash=.72+.28*vnoise(vec2(uv.x*3.0,uv.y*1.6-t*.5));

	float g=b*fall*wash;

	/* Hot cores tend toward the third colour, the body sits between the
	   first two — that's what gives a beam its centre. */
	vec3 col=mix(u_c1,u_c2,smoothstep(.10,.55,g));
	col=mix(col,u_c3,smoothstep(.55,.95,g)*.75);

	float a=clamp(g*1.35,0.,1.)*u_intensity;
	gl_FragColor=vec4(col*u_intensity,a);
